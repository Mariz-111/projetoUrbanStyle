-- ===================== CONSULTAS =====================

-- pedidos pendentes
SELECT p.*
FROM pedidos p
JOIN status_pedido s ON p.status_id = s.id
WHERE s.codigo = 'pendente';

-- pedidos com valor alto
SELECT id, subtotal, frete
FROM pedidos
WHERE subtotal > 100;

-- pedidos entre datas
SELECT *
FROM pedidos
WHERE data_pedido BETWEEN '2026-03-10' AND '2026-03-12';

-- pedidos de um cliente específico
SELECT *
FROM pedidos
WHERE cliente_id = 1;

-- ===================== UPDATES =====================

-- marcar como entregue
UPDATE pedidos
SET status_id = 4
WHERE id = 1;

-- alterar valor do pedido
UPDATE pedidos
SET subtotal = 200.00
WHERE id = 2;

-- ===================== JOINS =====================

-- produtos + categoria
SELECT 
p.nome,
p.preco,
c.nome AS categoria
FROM produtos p
JOIN categorias c ON p.categoria_id = c.id;

-- produtos + estoque
SELECT 
p.nome,
e.quantidade
FROM produtos p
JOIN estoque e ON p.id = e.produto_id;

-- pedidos + cliente
SELECT 
p.id,
p.subtotal,
c.email
FROM pedidos p
JOIN cliente c ON p.cliente_id = c.id;
