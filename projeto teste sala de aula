SELECT 
p.nome,
p.preco,
c.nome AS categoria
FROM produtos p
JOIN categorias c
ON p.categoria_id = c.id
WHERE c.id = 3;

SELECT 
p.nome,
f.cor,
p.tamanho,
e.quantidade
FROM produtos p
JOIN estoque e
ON e.produto_id = p.id
WHERE e.id = 2;

SELECT 
p.nome,
p.preco,
f.nome_empresa,
f.email
FROM produtos p
JOIN fornecedor f
ON p.fornecedor_id = f.id
WHERE f.id = 1;

SELECT 
p.id,
p.subtotal,
p.data_pedido,
c.nome,
c.email
FROM pedidos p
JOIN cliente c ON p.cliente_id = c.id;
